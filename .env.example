# PolicyGuard configuration. Copy to .env — everything is local and free.

# auto   : use Ollama when it answers, otherwise the documented heuristic fallback
# ollama : always try Ollama (raises no error, falls back on failure)
# mock   : never call a model (fast, deterministic evaluation)
LLM_MODE=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=45

# Where state lives (leave blank for the defaults inside the project)
PG_DB_PATH=
PG_WORKSPACE_DIR=

# Email drafts may only target these domains
ALLOWED_EMAIL_DOMAINS=college.edu,example.edu

# Risk thresholds for the full profile
RISK_ALLOW_MAX=39
RISK_APPROVAL_MIN=60
RISK_BLOCK_MIN=85

# Agent + SQL limits
MAX_AGENT_STEPS=6
SQL_ROW_LIMIT=50

# Gateway profile: baseline | rules | full
PG_PROFILE=full

# Access gate. Empty = local-only: loopback API calls and localhost console only.
# Set a long random value before exposing either service beyond your machine.
#   API     : Authorization: Bearer <token> | X-PolicyGuard-Token: <token> | Basic
#   Console : prompted for the same token
PG_ACCESS_TOKEN=

# CORS allowlist for the API (comma separated origins, no wildcard)
PG_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000
